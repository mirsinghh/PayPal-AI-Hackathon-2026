# Agent D (repo name: agentdeal). Copy to .env.local and fill in. NEVER commit real values: .env.local is git-ignored.
# Every variable below is SERVER-ONLY. There is no NEXT_PUBLIC_* variable in this project and there must never be one for a secret.
# The full table (what each is for, required/optional, what happens if it is missing) is AgentDeal_DOCS/V5/VERCEL_DEPLOYMENT.md.
# Check a configuration without printing any value:  npm run check:env

# ---------------------------------------------------------------------------------------------------------------------
# PayPal: Sandbox only. The app refuses to run payments in any other environment.
# ---------------------------------------------------------------------------------------------------------------------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret

# ---------------------------------------------------------------------------------------------------------------------
# Persistence + accounts (Supabase). Local dev uses JSON files in ./.data when these are empty (and accounts are off).
# Vercel REQUIRES all three: run supabase/schema.sql in the SQL editor first.
#   SUPABASE_URL                 Project URL
#   SUPABASE_ANON_KEY            the public "anon"/"publishable" key (Auth + RLS-scoped history reads). Still server-side only here.
#   SUPABASE_SERVICE_ROLE_KEY    the SECRET key (server writes only). Never expose it.
# ---------------------------------------------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------------------------------------------------
# AI provider. Recommended for the public demo: groq. There is NEVER an automatic switch to another provider.
# When the AI cannot answer (quota, timeout, errors, bad key) Agent D continues with server rules and says so.
#   AI_PROVIDER=groq    buyer GPT-OSS 120B, the four sellers GPT-OSS 20B   (needs GROQ_API_KEY)
#   AI_PROVIDER=gemini  the original engine; default when unset            (needs AI_API_KEY)
#   AI_PROVIDER=rules   no model API at all: server rules only (the safe way to switch AI off)
# ---------------------------------------------------------------------------------------------------------------------
AI_PROVIDER=groq

# Optional: use different providers for the two AI jobs. Both default to AI_PROVIDER, so leave them unset normally.
#   ANALYSIS_PROVIDER    writes the "why this offer" analysis (separate from the negotiation; Rules-based analysis if unavailable)
#   NEGOTIATION_PROVIDER writes the stores' replies, only when the user picks "AI Agents"
# ANALYSIS_PROVIDER=groq
# NEGOTIATION_PROVIDER=groq

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key
# Defaults shown; change only if you know why.
GROQ_BUYER_MODEL=openai/gpt-oss-120b
GROQ_SELLER_MODEL=openai/gpt-oss-20b
GROQ_EXPLANATION_MODEL=openai/gpt-oss-120b
# Reasoning effort for gpt-oss: low | medium | high (low keeps token use small on free plans).
GROQ_BUYER_REASONING=low
GROQ_SELLER_REASONING=low
# strict (JSON Schema Structured Outputs) | json_object. The server validates everything either way.
GROQ_STRUCTURED=strict
# Simultaneous requests per model (default 2). Stable beats fast on a free plan.
GROQ_MAX_CONCURRENCY=2
# Optional, only if you know your plan's limits (otherwise learned from Groq's response headers and Retry-After):
# GROQ_RPM_LIMIT=
# GROQ_TPM_LIMIT=
# GROQ_MAX_INPUT_TOKENS=3000
# GROQ_REASONING_HEADROOM=500
# GROQ_TIMEOUT_MS=40000

# Gemini (only if AI_PROVIDER or a *_PROVIDER above is gemini). Key from https://aistudio.google.com/apikey
AI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-3.5-flash
# Gemini only: requests per minute your plan allows (free tier = 5). 0 disables client-side pacing. Ignored by Groq.
AI_RPM_LIMIT=5

# ---------------------------------------------------------------------------------------------------------------------
# AI Agents run limits
# ---------------------------------------------------------------------------------------------------------------------
# The user picks "Server Rules" or "AI Agents" in the UI before each negotiation. This flag only sets the default for API
# callers that send no mode (legacy). Leave it false: AI Agents does not need it.
MULTI_AGENT_NEGOTIATION=false
# Wall-clock budget of one AI negotiation (ms, 5000-600000, default 40000). On Vercel use 30000: the function is limited to
# 60 s and the server caps this at 40000 there. After the budget the rest of the negotiation is finished with server rules.
MULTI_AGENT_DEADLINE_MS=30000
# Cap on model attempts per negotiation (8-40, default 16). Rejected replies use attempts too.
# MULTI_AGENT_MAX_CALLS=24
# TEST ONLY: single_call makes ONE model call write the whole script. Not for the public demo.
# MULTI_AGENT_ENGINE=single_call

# ---------------------------------------------------------------------------------------------------------------------
# App URL. Only Agent Auto-Buy uses it (PayPal sends the buyer back to APP_BASE_URL/api/auto-buy/payment-method/return).
# On Vercel set it to the public https URL, with no trailing slash.
# ---------------------------------------------------------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------------------------------------------------
# Agent Auto-Buy (needs the PayPal Vault permission on the Sandbox app: see AgentDeal_DOCS/V5/AUTO_BUY.md)
# 64 hex chars that encrypt saved PayPal tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. Locally (Sandbox) a dev key is derived from PAYPAL_CLIENT_SECRET if this is empty.
# ---------------------------------------------------------------------------------------------------------------------
AUTOBUY_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------------------------------------------------
# Local-only helpers (never set these on Vercel)
# ---------------------------------------------------------------------------------------------------------------------
# DATA_DIR=.data
# Only for scripts/create-demo-user.mjs:
# DEMO_USER_EMAIL=demo@example.test
# DEMO_USER_PASSWORD=
# Verbose log of invalid model output (never logs keys): AGENTS_DEBUG=1
