# Copy to .env.local and fill in. Never commit real values.

# PayPal (Sandbox only; the app refuses to run payments in any other environment)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret

# LLM provider: Google Gemini (free tier). Key from https://aistudio.google.com/apikey
# Without a key the app falls back to labelled rule-based explanations.
AI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-3.5-flash

# AI provider for the agents: groq | gemini | rules. Unset = gemini (the original engine, unchanged).
#   groq   -> Agent D on GPT-OSS 120B, the four sellers on GPT-OSS 20B (needs GROQ_API_KEY)
#   gemini -> needs AI_API_KEY above
#   rules  -> no model API: the deterministic engine only
# There is never an automatic switch between providers.
AI_PROVIDER=gemini

# V5: the two AI roles can use different providers. Both default to AI_PROVIDER, so leaving them unset changes nothing.
#   ANALYSIS_PROVIDER    -> writes the "why this offer" analysis. NEVER affected by the Server/AI Responses switch.
#   NEGOTIATION_PROVIDER -> writes the stores' replies, only when the user picks "AI Responses".
# Tip: Groq answers in ~1 s, so ANALYSIS_PROVIDER=groq keeps "Start negotiating" snappy if Gemini is slow or rate limited.
# ANALYSIS_PROVIDER=groq
# NEGOTIATION_PROVIDER=groq

# Groq (https://console.groq.com/keys). Quotas depend on your account: the engine learns them from the response
# headers and honours Retry-After. Optional limits below are only for when you know your plan.
GROQ_API_KEY=your-groq-api-key
GROQ_BUYER_MODEL=openai/gpt-oss-120b
GROQ_SELLER_MODEL=openai/gpt-oss-20b
GROQ_EXPLANATION_MODEL=openai/gpt-oss-120b
# Reasoning effort for gpt-oss: low | medium | high (low keeps token use small on free plans).
GROQ_BUYER_REASONING=low
GROQ_SELLER_REASONING=low
# strict (JSON Schema Structured Outputs) | json_object. The server validates everything either way.
GROQ_STRUCTURED=strict
# Simultaneous requests per model (default 2). Stable beats fast on a free plan.
GROQ_MAX_CONCURRENCY=2
# Optional, only if you know your plan's limits (otherwise left unset and learned from headers):
# GROQ_RPM_LIMIT=
# GROQ_TPM_LIMIT=
# GROQ_MAX_INPUT_TOKENS=3000
# GROQ_REASONING_HEADROOM=500

# Persistence + accounts. Local dev uses JSON files in ./.data when these are empty (no accounts then).
# Production (Vercel) REQUIRES Supabase: run supabase/schema.sql in the SQL editor, then set all three. All are SERVER-ONLY:
# nothing here is NEXT_PUBLIC_*, the browser never talks to Supabase.
#   SUPABASE_URL                 Project URL
#   SUPABASE_ANON_KEY            the public "anon"/"publishable" key (Auth + RLS-scoped history reads)
#   SUPABASE_SERVICE_ROLE_KEY    the SECRET key (server writes only). Never commit it.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional, only for scripts/create-demo-user.mjs (never commit real values):
# DEMO_USER_EMAIL=demo@example.test
# DEMO_USER_PASSWORD=
# DATA_DIR=.data

# V5: the user chooses "Server Responses" or "AI Responses" in the UI before each negotiation, and the server validates and
# records it. Choosing AI Responses does NOT need this flag. The flag only sets the default for API callers that send no
# mode (legacy). AI Responses falls back to server rules, labelled, when the provider has no key / quota / catalogue match.
MULTI_AGENT_NEGOTIATION=false
# Provider quota in requests/minute (Gemini free tier = 5; a full negotiation needs up to ~15 calls).
# Pacing keeps runs from hitting 429s. Set 0 to disable pacing on a paid plan.
AI_RPM_LIMIT=5
# Wall-clock budget of one negotiation. On the free tier use ~300000 (5 min); on a paid plan 40000 is plenty.
MULTI_AGENT_DEADLINE_MS=40000
# Cap on model attempts per negotiation (8-40, default 16). Rejected replies use attempts too.
# MULTI_AGENT_MAX_CALLS=24
# TEST ONLY: set to single_call to make ONE Gemini call write the whole script (all agents, rounds, final choice).
# The server still validates every piece; the run is labelled as a single-call script, not independent agents.
# MULTI_AGENT_ENGINE=single_call

APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AgentDeal
